# Official network: https://docs.robinhood.com/chain/connecting/
ROBINHOOD_RPC_HTTP=
ROBINHOOD_CHAIN_ID=4663
# Set your provider's private endpoints here, never in source code.
ROBINHOOD_RPC_WS=
# Filtered launch notifications avoid paying for every chain header.
ROBINHOOD_WS_SUBSCRIPTION=logs
SCANNER_MODE=live
BACKFILL_ENABLED=false
LIVE_TRANSPORT_MODE=ws_first
LIVE_START_OVERLAP_BLOCKS=5
# Bounded HTTP only at startup/reconnect; larger gaps are recorded, never silently scanned.
LIVE_MAX_STARTUP_RECOVERY_BLOCKS=500
LIVE_MAX_RECOVERY_BLOCKS=1000
HEAD_HEALTHCHECK_SECONDS=60
# Optional basic connectivity test only; never used automatically by the watcher.
ROBINHOOD_RPC_FALLBACK_HTTP=https://rpc.mainnet.chain.robinhood.com
PONS_FACTORIES=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
STOCK_ASSETS_URL=https://api.robinhood.com/rhj/assets
POLL_SECONDS=5
RPC_TIMEOUT=20
RPC_REQUESTS_PER_SECOND=5
RETRY_MAX_SECONDS=60
RETRY_BASE_SECONDS=2
RPC_MAX_ATTEMPTS=5
CONFIRMATIONS=3
OVERLAP_BLOCKS=5
BATCH_BLOCKS=50
# Alchemy Free permits at most 10 blocks per eth_getLogs query.
LOG_BLOCK_RANGE=10
BLOCK_RETENTION=10000
MAX_REORG_DEPTH=100
# Legacy Phase 1 setting, ignored by live mode. Use app.backfill for explicit ranges.
START_BLOCK=
DATABASE_PATH=data/scanner.db
LOG_PATH=logs/scanner.log
