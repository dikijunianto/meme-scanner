# Separate Phase 2B settings; Validation credentials live in protected config/flow-rpc.env.
FLOW_TRACKING_ENABLED=false
FLOW_PROVIDER_SPLIT_ENABLED=false
FLOW_DATABASE=/opt/meme-scanner/data/flow.db
FLOW_FEATURE_WINDOWS=30,60,300,900,3600
FLOW_MAX_ACTIVE_SUBSCRIPTIONS=64
FLOW_MAX_HTTP_CALLS_PER_DAY=1000
FLOW_MAX_HTTP_CALLS_PER_MINUTE=12
FLOW_MAX_RECOVERY_GETLOGS_PER_DAY=400
# Normal startup recovery remains limited to 100 blocks per filter.
FLOW_SECONDARY_WS_BYTES_PER_DAY=64000000
FLOW_TX_ENRICHMENT_ENABLED=false
