[Unit]
Description=Sampled early flow collector (independent read-only chain service)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/meme-scanner
ExecStart=/opt/meme-scanner/.venv/bin/python -m app.flow_worker
Environment=PYTHONUNBUFFERED=1
Environment=FLOW_ENV=/opt/meme-scanner/config/flow.env
UMask=0077
Restart=on-failure
RestartSec=30
MemoryMax=128M
CPUQuota=20%
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/meme-scanner/data
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
